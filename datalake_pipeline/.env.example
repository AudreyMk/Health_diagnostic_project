# ============================================================
# MedRAG — Configuration (.env)
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- AWS S3 (ingestion uniquement) ---
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# S3_BUCKET_ALIAS=datalake-rduf6fuy93mcos7fgtyaoy8h5or4neun1a-s3alias

# --- PostgreSQL ---
PG_DSN=postgresql://medrag:medrag_2024@localhost:5432/medrag

# --- MongoDB ---
MONGO_URI=mongodb://medrag:medrag_2024@localhost:27017/

# --- Claude API (OBLIGATOIRE pour l'API RAG) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Embedding ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH=64
EMBED_RECONNECT_EVERY=25

# --- Parametres RAG ---
TOP_K=8
TOP_K_CENTERS=5
MAX_DISTANCE_METERS=20000
MIN_SIMILARITY=0.25

# --- Pool PostgreSQL ---
PG_POOL_MIN=2
PG_POOL_MAX=10

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
