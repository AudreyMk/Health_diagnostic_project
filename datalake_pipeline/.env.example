# ============================================================
# MedRAG v2 — Configuration (template)
# Copier ce fichier en .env puis remplir les valeurs réelles.
#   cp .env.example .env
# Le fichier .env est ignoré par git (.gitignore).
# ============================================================

# --- PostgreSQL (port 5433 pour éviter conflit avec v1) ---
PG_DSN=postgresql://medrag:medrag_2024@localhost:5433/medrag

# --- MongoDB (port 27018) ---
MONGO_URI=mongodb://medrag:medrag_2024@localhost:27018/

# --- Claude API ---
# Récupérer une clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-6

# --- ICD-11 API WHO (Phase B enrichissement pathologies) ---
# Inscription gratuite : https://icd.who.int/icdapi
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# --- Embedding ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH=64

# --- Paramètres RAG (3 pools) ---
TOP_K=8
TOP_K_PATHOLOGIES=4
TOP_K_PATIENTS=3
TOP_K_CLINICAL=2
TOP_K_CENTERS=5
MAX_DISTANCE_METERS=20000
MIN_SIMILARITY=0.25
AGE_RANGE=15

# --- Pool PostgreSQL (psycopg3) ---
PG_POOL_MIN=2
PG_POOL_MAX=10

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
